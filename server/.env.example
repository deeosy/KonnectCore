PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/konnectcore?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Optional: comma-separated DNS server IPs to use instead of the system resolver.
# Only needed when the system cannot resolve the SRV record of a mongodb+srv:// URI.
# DNS_SERVERS=8.8.8.8,1.1.1.1
