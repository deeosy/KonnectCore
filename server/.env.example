PORT=5000
# MongoDB Atlas connection used by the application. The database lives in the
# shared Atlas cluster, and during development the same deployment is
# typically opened in MongoDB Compass to inspect and manage collections.
#
# Copy the connection string generated by Atlas for your database and replace
# the placeholder credentials below with those of the database user you have
# been granted access to. Each developer connects with their own authorized
# user, not a shared superuser.
#
# Never commit the real connection string or credentials — keep them in your
# local server/.env file, which stays untracked by Git. This file is only a
# template; copy it to .env and fill in your own values.
MONGODB_URI=mongodb+srv://KonnectCore:<db_password>@cluster0.ng6nveu.mongodb.net/
# Optional: when MONGODB_URI has no database in the path (e.g.
# mongodb://host:27017 without a trailing /<db>), the server connects to this
# database instead of MongoDB's default "test". Defaults to "konnectcore".
# DB_NAME=konnectcore
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Optional: comma-separated DNS server IPs to use instead of the system resolver.
# Only needed when the system cannot resolve the SRV record of a mongodb+srv:// URI.
# DNS_SERVERS=8.8.8.8,1.1.1.1
